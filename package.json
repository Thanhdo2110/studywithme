{
  "name": "studywithme",
  "version": "3.0.0",
  "private": true,
  "description": "StudyWithMe — phòng học tập trung trực tuyến cho học sinh THPT (frontend + REST API + Postgres + Redis, đóng gói Docker)",
  "type": "commonjs",
  "main": "server/index.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "reset-db": "node server/reset-db.js",
    "migrate:sqlite": "node server/migrate-sqlite.js",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f app",
    "compose:test": "docker compose exec app npm test"
  },
  "keywords": [
    "study",
    "pomodoro",
    "postgres",
    "redis",
    "docker",
    "vietnam"
  ],
  "license": "MIT",
  "dependencies": {
    "pg": "^8.23.1",
    "redis": "^6.3.1"
  }
}
