# Chạy app trực tiếp trên máy (không qua Docker) thì trỏ vào cổng đã map của compose.
DATABASE_URL=postgres://swm:swm@localhost:5433/swm
REDIS_URL=redis://localhost:6380

# Database dùng riêng cho `npm test` (bị xoá schema mỗi lần chạy).
TEST_DATABASE_URL=postgres://swm:swm@localhost:5433/swm_test

PORT=3000
# Số ngày giữ tài khoản khách không hoạt động trước khi dọn.
GUEST_RETENTION_DAYS=14

# Chỉ bật khi chạy backend sau nginx (frontend gọi /api qua proxy).
# TRUST_PROXY=1
# SERVE_STATIC=false
