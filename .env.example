# Sao chép thành .env và điền GIÁ TRỊ THẬT (không dùng ${...} — biến không tự thay trong .env!)
# 1. sinh mật khẩu:  openssl rand -hex 24
# 2. dán CÙNG MỘT mật khẩu vào cả 2 dòng dưới đây:

POSTGRES_PASSWORD=thay-chuoi-ngau-nhien-vao-day

# 3. DATABASE_URL phải chứa đúng mật khẩu trên (thay <mat-khau> bằng chuỗi vừa dán):
DATABASE_URL=postgres://swm:<mat-khau>@postgres:5432/swm

# Redis nội bộ docker network — giữ nguyên:
REDIS_URL=redis://redis:6379

# Khi VPS đứng sau Cloudflare (Full strict hoặc tunnel):
COOKIE_SECURE=1
