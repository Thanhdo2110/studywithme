# Sao chép thành .env và điền giá trị thật. .env đã trong .gitignore.
POSTGRES_PASSWORD=doi-thanh-chuoi-ngau-nhien
DATABASE_URL=postgres://swm:${POSTGRES_PASSWORD}@postgres:5432/swm
REDIS_URL=redis://redis:6379
# TRUST_PROXY=1            # đã đặt trong docker-compose.yml
# GUEST_RETENTION_DAYS=14

# Bật khi chạy sau Cloudflare Tunnel (origin nhận HTTP từ tunnel)
COOKIE_SECURE=1

# Khi VPS đứng sau Cloudflare proxy (A record mây vàng):
# - SSL mode Flexible + Origin Rule rewrite port 3000 (xem DEPLOY.md)
# - Firewall: bash deploy/cf-firewall.sh 3000
COOKIE_SECURE=1
